# Settings for cleanup_workspace.sh
# Variables already set in the shell/cron environment override these values.

# 1 = only print what would be deleted, 0 = really delete
DRY_RUN=1

# Environments to leave untouched (valid: prod, dev, uat, staging, qa)
SKIP_ENVS=prod

# CSV with the workspace paths (used in "all" mode)
CSV_FILE=/home/buildpiper/cleanup_test/workspace_paths.csv

# Delete folders with no changes in the last N days
DAYS=10

# Deletion is blocked from BLOCK_START to BLOCK_END (server time, 0-23)
BLOCK_START=20
BLOCK_END=22

# Maximum run time in minutes (0 = no limit)
RUN_MINS=5

# Log folder and number of execution logs to keep
LOG_DIR=/home/buildpiper/.log/cleanup
LOG_KEEP=2
